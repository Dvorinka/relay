{
  "name": "relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/web",
    "packages/api-client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @relay/web",
    "build": "npm run build --workspace @relay/web",
    "test": "npm test --workspace @relay/web --if-present",
    "api": "openapi-typescript api/openapi.yaml -o packages/api-client/src/generated/schema.ts"
  },
  "devDependencies": {
    "nanoid": "5.1.16",
    "openapi-typescript": "7.13.0"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "^5.1.16"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    },
    "seroval": "^1.6.8",
    "seroval-plugins": "^1.6.8"
  }
}
