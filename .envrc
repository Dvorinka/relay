# Local, non-secret environment for this repo. direnv loads it automatically
# (`direnv allow` once per checkout); without it the DB-backed e2e suite
# silently skips — RELAY_TEST_DATABASE_URL must be set, not optional.
export RELAY_TEST_DATABASE_URL="postgres://relay:relay@127.0.0.1:5432/relay_e2e?sslmode=disable"
