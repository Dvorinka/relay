# Relay configuration - copy to .env and fill in. Never commit .env.

# --- Core ---
# Postgres connection string
DATABASE_URL=postgres://relay:relay@localhost:5432/relay?sslmode=disable

# Public URL the app is served at (cookies are Secure when this is https)
RELAY_PUBLIC_URL=http://localhost:8080

# Public landing/marketing URL used as the GitHub App homepage (optional, defaults to RELAY_PUBLIC_URL)
RELAY_LANDING_URL=

# Secret for session token signing / misc crypto. Generate: openssl rand -hex 32
AUTH_SECRET=

# Listen address for the relay server
RELAY_LISTEN_ADDR=:8080

# --- Auth ---
# Session lifetime in hours (sliding renewal)
AUTH_SESSION_TTL_HOURS=720
# Set to "true" only for local http development (disables Secure cookie flag)
AUTH_INSECURE_DEV=true

# SMTP for password-reset / verification emails. If unset, mail is logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=relay@example.com

# --- Storage (S3-compatible: MinIO, S3, R2, ...) ---
STORAGE_ENDPOINT=http://localhost:9000
# Browser-reachable endpoint used to mint presigned download URLs. Defaults
# to STORAGE_ENDPOINT; set it when the upload endpoint is internal-only
# (e.g. http://storage:9000 inside Docker but http://localhost:9000 outside).
STORAGE_PUBLIC_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=relay
# Max upload size in MiB
STORAGE_MAX_UPLOAD_MIB=25
# Presigned download URL TTL in seconds
STORAGE_PRESIGN_TTL=300

# --- GitHub App (phase 6+) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_WEBHOOK_SECRET=
# Optional: pre-created app slug for the manifest flow callback
GITHUB_APP_SLUG=

# --- Optional ---
# DragonflyDB/Redis URL - only needed if the cache layer is enabled
CACHE_URL=
# Log level: debug, info, warn, error
LOG_LEVEL=info

# --- Web Push ---
# VAPID keypair for browser push notifications. If unset, ephemeral keys are
# generated at startup (fine for dev; subscriptions die on restart).
# Generate: npx web-push generate-vapid-keys
RELAY_VAPID_PUBLIC_KEY=
RELAY_VAPID_PRIVATE_KEY=
# Contact embedded in the VAPID JWT (mailto: or https:)
RELAY_VAPID_SUBJECT=mailto:relay@example.com

# --- GitHub integration ---
# Optional dev override: personal access token used for GitHub REST calls
# (development panel, repo picker) when no GitHub App is registered.
# In production, register the app from workspace Settings -> GitHub instead —
# webhooks, installation tokens and multi-workspace linking need it.
GITHUB_TOKEN=
