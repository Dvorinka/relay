# Relay configuration - copy to .env and fill in. Never commit .env.

# --- Core ---
# Postgres connection string
DATABASE_URL=postgres://relay:relay@localhost:5432/relay?sslmode=disable

# Public URL the app is served at (cookies are Secure when this is https)
RELAY_PUBLIC_URL=http://localhost:8080

# Secret for session token signing / misc crypto. Generate: openssl rand -hex 32
AUTH_SECRET=

# Listen address for the relay server
RELAY_LISTEN_ADDR=:8080

# --- Auth ---
# Session lifetime in hours (sliding renewal)
AUTH_SESSION_TTL_HOURS=720
# Set to "true" only for local http development (disables Secure cookie flag)
AUTH_INSECURE_DEV=true

# SMTP for password-reset / verification emails. If unset, mail is logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=relay@example.com

# --- Storage (S3-compatible: MinIO, S3, R2, ...) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=relay
# Max upload size in MiB
STORAGE_MAX_UPLOAD_MIB=25
# Presigned download URL TTL in seconds
STORAGE_PRESIGN_TTL=300

# --- GitHub App (phase 6+) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_WEBHOOK_SECRET=
# Optional: pre-created app slug for the manifest flow callback
GITHUB_APP_SLUG=

# --- Optional ---
# DragonflyDB/Redis URL - only needed if the cache layer is enabled
CACHE_URL=
# Log level: debug, info, warn, error
LOG_LEVEL=info
