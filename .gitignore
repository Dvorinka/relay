# env / secrets
.env
.env.*
!.env.example
!.envrc

# Go
/bin/
/dist/
*.test
coverage.out

# Node / frontend
node_modules/
apps/*/node_modules/
apps/*/dist/
apps/*/dist-single/
.playwright-mcp/
apps/*/.output/
*.tsbuildinfo

# Wails / mobile build output — build/bin is generated; appicon.png and
# build/windows/ (icon, manifest, info.json) are source assets and committed
apps/desktop/build/bin/
apps/desktop/frontend/
# embedded SPA bundle — CI copies apps/web/dist here before wails build;
# only the stub index.html is committed
apps/desktop/web/dist/*
!apps/desktop/web/dist/index.html
apps/mobile/.expo/
apps/mobile/android/

# generated code IS committed (sqlc output and the OpenAPI-typed client)

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/*

# local data
/tmp/
*.log
apps/desktop/desktop
.vercel
